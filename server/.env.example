# Django Configuration
DJANGO_SECRET_KEY=django-insecure-decisioniq-production-secret-key-change-me-to-a-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CORS Configuration (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MongoDB Connection
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# For local MongoDB: mongodb://localhost:27017
MONGODB_URI=mongodb://localhost:27017
MONGO_DB_NAME=decision_iq_db

# JWT Token Settings
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
